# -----------------------------------------------------------------------
# HR Policy Assistant - Backend Environment Variables
# -----------------------------------------------------------------------
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# .env is in .gitignore — NEVER commit your actual API key to Git.
# -----------------------------------------------------------------------

# Server port (optional, defaults to 5000)
PORT=5000

# -----------------------------------------------------------------------
# LLM Mode - choose which approach to use:
#
#   mock   -> Dummy LLM (default). No API key needed. Templates the
#             retrieved chunk into an answer. Full pipeline works,
#             only "generation" is simulated. Good for demos/dev.
#
#   openai -> Real OpenAI API (gpt-4o-mini). Requires OPENAI_API_KEY.
#             Grounded prompt — model answers ONLY from retrieved context.
# -----------------------------------------------------------------------
LLM_MODE=mock

# OpenAI API key (only needed when LLM_MODE=openai)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here
